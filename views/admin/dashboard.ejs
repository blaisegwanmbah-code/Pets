<%- include('../partials/header') %>

<main class="pt-32 pb-24 bg-art-bg min-h-screen">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="flex justify-between items-center mb-16">
      <div>
        <h1 class="text-5xl font-bold italic">Admin Dashboard</h1>
        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.3em] mt-2">MiniGooDoodle Management</p>
      </div>
      <a href="/" class="text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-slate-900">View Public Site</a>
    </div>

    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Sidebar Actions -->
      <div class="lg:col-span-1 space-y-8">
        <div class="bg-white p-8 rounded-[40px] shadow-xl border border-art-border">
          <h2 class="text-xl font-bold mb-8 italic">Add New Puppy</h2>
          <form action="/admin/puppies/add" method="POST" enctype="multipart/form-data" class="space-y-6">
            <div class="space-y-2">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Puppy Name</label>
              <input type="text" name="name" required class="w-full px-4 py-3 rounded-xl border-none ring-1 ring-slate-100 focus:ring-doodle-pink/20 transition bg-slate-50 text-sm">
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Breed</label>
              <select name="breed" class="w-full px-4 py-3 rounded-xl border-none ring-1 ring-slate-100 transition bg-slate-50 text-sm">
                <option>Mini Goldendoodle</option>
                <option>Toy Poodle</option>
              </select>
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Color & Generation</label>
              <input type="text" name="color" placeholder="e.g. Red F1B" required class="w-full px-4 py-3 rounded-xl border-none ring-1 ring-slate-100 transition bg-slate-50 text-sm">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Gender</label>
                <select name="gender" class="w-full px-4 py-3 rounded-xl border-none ring-1 ring-slate-100 transition bg-slate-50 text-sm">
                  <option>Male</option>
                  <option>Female</option>
                </select>
              </div>
              <div class="space-y-2">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Born Date</label>
                <input type="text" name="born" placeholder="May 12, 2026" required class="w-full px-4 py-3 rounded-xl border-none ring-1 ring-slate-100 transition bg-slate-50 text-sm">
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Photo</label>
              <input type="file" name="image" required class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-[10px] file:font-semibold file:bg-pink-50 file:text-doodle-pink hover:file:bg-pink-100">
            </div>
            <button type="submit" class="w-full bg-doodle-pink text-white py-4 rounded-2xl font-bold uppercase tracking-widest text-[10px] shadow-lg shadow-pink-100">
              Publish Listing
            </button>
          </form>
        </div>
      </div>

      <!-- Main Content: Applications -->
      <div class="lg:col-span-2 space-y-8">
        <div class="bg-white p-10 rounded-[40px] shadow-xl border border-art-border">
          <h2 class="text-xl font-bold mb-8 italic">Adoption Applications</h2>
          <div class="space-y-6">
            <% if (applications && applications.length > 0) { %>
              <% applications.forEach(app => { %>
                <div class="p-6 rounded-3xl bg-art-bg border border-art-border hover:shadow-md transition">
                  <div class="flex justify-between items-start mb-4">
                    <div>
                      <h3 class="font-bold text-lg"><%= app.name %></h3>
                      <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1"><%= app.breed %> • <%= app.homeType %></p>
                    </div>
                    <span class="px-3 py-1 bg-white border border-art-border rounded-full text-[10px] font-bold uppercase text-slate-400"><%= app.status %></span>
                  </div>
                  <p class="text-sm text-slate-600 italic leading-relaxed mb-4">"<%= app.lifestyle %>"</p>
                  <div class="flex justify-between items-center text-[10px] font-bold uppercase tracking-widest text-slate-400">
                    <div><%= app.phone %> • <%= app.email %></div>
                    <div><%= new Date(app.submittedAt).toLocaleDateString() %></div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-100">
                <p class="text-slate-400 italic">No applications received yet.</p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Manage Puppy Listings -->
        <div class="bg-white p-10 rounded-[40px] shadow-xl border border-art-border">
          <div class="flex justify-between items-center mb-8">
            <h2 class="text-xl font-bold italic">Current Puppy Listings</h2>
            <span class="text-[10px] font-bold uppercase text-slate-400"><%= puppies ? puppies.length : 0 %> Listings</span>
          </div>
          <div class="grid sm:grid-cols-2 gap-6">
            <% if (puppies && puppies.length > 0) { %>
              <% puppies.forEach(puppy => { %>
                <div class="p-6 rounded-3xl bg-art-bg border border-art-border hover:shadow-md transition flex flex-col justify-between">
                  <div class="flex gap-4 items-start mb-4">
                    <img src="<%= puppy.image %>" alt="<%= puppy.name %>" class="w-20 h-20 rounded-2xl object-cover ring-4 ring-white">
                    <div>
                      <h3 class="font-bold text-lg italic"><%= puppy.name %></h3>
                      <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1"><%= puppy.breed %></p>
                      <span class="inline-block mt-2 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest <%= puppy.status === 'Available' ? 'bg-green-50 text-green-600' : 'bg-orange-50 text-orange-600' %>">
                        <%= puppy.status %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="flex gap-2">
                    <form action="/admin/puppies/status/<%= puppy.id %>" method="POST" class="flex-1">
                      <button type="submit" class="w-full text-center px-4 py-3 bg-white border border-art-border rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-slate-50 transition">
                        <%= puppy.status === 'Available' ? 'Mark Reserved' : 'Mark Available' %>
                      </button>
                    </form>
                    <form action="/admin/puppies/delete/<%= puppy.id %>" method="POST" class="flex-none" onsubmit="return confirm('Delete this listing?')">
                      <button type="submit" class="p-3 bg-white border border-art-border rounded-xl text-red-400 hover:bg-red-50 hover:text-red-600 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="col-span-full text-center py-12 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-100">
                <p class="text-slate-400 italic font-medium">No puppies listed yet.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
