<%- include('../partials/header') %>

<main class="pt-40 pb-24 bg-art-bg min-h-screen">
  <div class="max-w-md mx-auto px-6">
    <div class="bg-white p-12 rounded-[50px] shadow-2xl border border-art-border text-center">
      <div class="w-16 h-16 bg-slate-900 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      </div>
      <h1 class="text-3xl font-bold mb-4 italic">Admin Login</h1>
      <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-10">Access Dashboard</p>
      
      <% if (error) { %>
        <div class="bg-red-50 text-red-500 p-4 rounded-2xl mb-6 text-sm font-bold"><%= error %></div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-6">
        <input type="password" name="password" placeholder="Admin Password" required class="w-full px-6 py-4 rounded-2xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-slate-50 text-center font-bold">
        <button type="submit" class="w-full bg-slate-900 text-white py-4 rounded-2xl font-bold uppercase tracking-widest text-xs hover:brightness-110 transition shadow-lg">
          Log In
        </button>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
