<%- include('partials/header') %>

<main class="pt-40 pb-24 bg-white">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-[10px] font-bold text-doodle-pink uppercase tracking-[0.4em] mb-4 block">Application</span>
      <h1 class="text-5xl font-bold mb-4 text-slate-900 italic">Finding the <span class="not-italic">Perfect Match</span></h1>
      <p class="text-slate-500 text-lg mt-6">Tell us about your home and lifestyle. We review all applications within 48 hours.</p>
    </div>

    <form action="/apply" method="POST" class="space-y-10 bg-art-bg p-12 rounded-[60px] border border-art-border shadow-inner">
      <div class="grid md:grid-cols-2 gap-10">
        <div class="space-y-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Full Name</label>
          <input type="text" name="name" required class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white">
        </div>
        <div class="space-y-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Phone Number</label>
          <input type="tel" name="phone" required class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white">
        </div>
      </div>

      <div class="space-y-3">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Email Address</label>
        <input type="email" name="email" required class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white">
      </div>

      <div class="grid md:grid-cols-2 gap-10">
        <div class="space-y-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Preferred Breed</label>
          <select name="breed" class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white appearance-none">
            <option>Mini Goldendoodle</option>
            <option>Toy/Mini Poodle</option>
          </select>
        </div>
        <div class="space-y-3">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Housing Type</label>
          <select name="homeType" class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white appearance-none">
            <option>House with Yard</option>
            <option>Apartment / Condo</option>
            <option>Townhome</option>
          </select>
        </div>
      </div>

      <div class="space-y-3">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Tell us about your household lifestyle</label>
        <textarea name="lifestyle" rows="4" placeholder="Children, pets, work schedule..." class="w-full px-8 py-5 rounded-3xl border-none ring-1 ring-slate-200 focus:ring-4 focus:ring-doodle-pink/10 focus:outline-none transition bg-white"></textarea>
      </div>

      <button type="submit" class="w-full bg-doodle-pink text-white py-6 rounded-3xl text-sm font-bold uppercase tracking-[0.2em] shadow-xl shadow-pink-100 hover:brightness-105 transition">
        Submit Application
      </button>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
