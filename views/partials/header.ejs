<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Elite Poodles & Goldendoodles Las Vegas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@300;500;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --doodle-pink: #FF8E8E;
      --art-bg: #FEF9F8;
      --art-border: #F2E5E2;
    }
    body { font-family: 'Quicksand', sans-serif; background-color: var(--art-bg); color: #2D2D2D; }
    h1, h2, h3, h4, .font-serif { font-family: 'Playfair Display', serif; }
    .font-sans-ui { font-family: 'Quicksand', sans-serif; }
    .bg-doodle-pink { background-color: var(--doodle-pink); }
    .text-doodle-pink { color: var(--doodle-pink); }
    .border-art-border { border-color: var(--art-border); }
  </style>
</head>
<body class="selection:bg-doodle-pink selection:text-white">
  <nav class="fixed w-full z-50 transition-all duration-500 bg-white/95 backdrop-blur-md shadow-sm py-4 border-b border-art-border">
    <div class="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-doodle-pink rounded-full flex items-center justify-center shadow-sm group-hover:rotate-12 transition-transform">
          <svg viewBox="0 0 24 24" class="w-6 h-6 text-white" fill="currentColor"><path d="M12,2C10.9,2 10,2.9 10,4C10,5.1 10.9,6 12,6C13.1,6 14,5.1 14,4C14,2.9 13.1,2 12,2M7,7C5.9,7 5,7.9 5,9C5,10.1 5.9,11 7,11C8.1,11 9,10.1 9,9C9,7.9 8.1,7 7,7M17,7C15.9,7 15,7.9 15,9C15,10.1 15.9,11 17,11C18.1,11 19,10.1 19,9C19,7.9 18.1,7 17,7M12,13C9.2,13 7,15.2 7,18C7,20.8 9.2,23 12,23C14.8,23 17,20.8 17,18C17,15.2 14.8,13 12,13Z"/></svg>
        </div>
        <span class="text-xl md:text-2xl font-bold tracking-tight uppercase text-slate-800 font-sans-ui">MiniGooDoodle</span>
      </a>
      <div class="hidden md:flex space-x-10 items-center">
        <a href="/available" class="text-[11px] font-bold tracking-[0.2em] uppercase text-slate-400 hover:text-doodle-pink transition-colors">Collection</a>
        <a href="/#about" class="text-[11px] font-bold tracking-[0.2em] uppercase text-slate-400 hover:text-doodle-pink transition-colors">Our Story</a>
        <a href="/#process" class="text-[11px] font-bold tracking-[0.2em] uppercase text-slate-400 hover:text-doodle-pink transition-colors">The Process</a>
        <a href="/apply" class="bg-doodle-pink text-white px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest hover:shadow-xl hover:brightness-105 transition-all shadow-lg shadow-pink-100">Apply Now</a>
      </div>
    </div>
  </nav>
